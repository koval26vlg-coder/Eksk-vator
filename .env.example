# Режим: arbitrage (межбиржа) | scalping (импульс на одной бирже)
BOT_STRATEGY=arbitrage

# Котировки: rest (опрос) | ws (WebSocket стакан, CCXT Pro — чаще тики, удобнее для скальпинга)
DATA_MODE=rest
# Глубина стакана; для Bybit spot + DATA_MODE=ws допустимы только 1, 50, 200, 1000
ORDERBOOK_LIMIT=50
RISK_MAX_NOTIONAL_PER_ORDER=100
# Скальпинг + AUTO_TRADE: если строки пустые — max(5, бирж×пар) и max(500, слоты×AUTO_TRADE_NOTIONAL).
# Иначе значения из .env поднимаются до бирж×пар и суммарного номинала (не 5/250 при 10 потоках).
# Чтобы не поднимать — RISK_STRICT_RISK_LIMITS=true
RISK_MAX_OPEN_ORDERS=5
RISK_MAX_TOTAL_NOTIONAL=500
# RISK_STRICT_RISK_LIMITS=true
#
# Пример «малый бюджет» ~20 USDT (paper или осторожный live): строгие лимиты без автоподъёма до бирж×пары
# RISK_STRICT_RISK_LIMITS=true
# RISK_MAX_NOTIONAL_PER_ORDER=10
# RISK_MAX_OPEN_ORDERS=2
# RISK_MAX_TOTAL_NOTIONAL=20
# AUTO_TRADE_NOTIONAL=8
# AUTO_TRADE_MAX_OPEN_ORDERS=2
# CAPITAL_MAX_SESSION_LOSS_QUOTE=10
# Итог сессии в paper: реализованный PnL по всем закрытым сделкам — блок в логе «PAPER: итог сессии» при остановке

# Управление капиталом (снижение убытков; лимит сессии — только в paper по реализ. PnL)
# Стоп по сессии: остановка новых входов при realized PnL <= -лимита (quote, напр. USDT)
# CAPITAL_MAX_SESSION_LOSS_QUOTE=1.0
# Пауза после убыточной сделки (sell с отрицательным приростом PnL), сек; 0 = выкл.
# CAPITAL_COOLDOWN_AFTER_LOSS_SECONDS=600
# Стоп после N убыточных сделок подряд (sell); 0 = выкл. Сброс только при перезапуске или executor.close()
# CAPITAL_MAX_CONSECUTIVE_LOSSES=0

AUTO_TRADE=false
# Профиль авто-торговли: один переключатель, который выставляет согласованный набор параметров.
# - quality: качество сделок (меньше входов/шума, TP не "в ноль" после комиссий, сильнее подтверждение тренда).
#   В коде: TP=8 net, min impulse=14, TA DI≥8, ATR×spread mult=0.28, см. блок quality в `config.py`.
# AUTO_TRADE_PROFILE=quality
# Номинал одной сделки (USDT для USDT-пар), не выше RISK_MAX_NOTIONAL_PER_ORDER
AUTO_TRADE_NOTIONAL=50
# Пауза между авто-сделками (сек); 5–15 — меньше churn подряд
AUTO_TRADE_COOLDOWN_SECONDS=10
# exchange_symbol — кулдаун по (биржа, пара); symbol — одна авто-сделка на пару на всех биржах (рекомендуется при SCALPING_EXCHANGES=…,…)
AUTO_TRADE_COOLDOWN_SCOPE=symbol
# Скальпинг+AUTO_TRADE: максимум одновременных заявок (сверх RISK_*; пусто — не сужать)
# AUTO_TRADE_MAX_OPEN_ORDERS=6
# Quality-first: если позиция по паре уже есть — не наращивать; разрешать только уменьшающие ордера (reduce-only по смыслу)
# AUTO_TRADE_REDUCE_ONLY=true
# Reduce-only область: exchange_symbol/leg — отдельно на каждой бирже; symbol — глобально по паре на всех биржах
# AUTO_TRADE_REDUCE_ONLY_SCOPE=symbol
# Пыль позиции (quote, напр. USDT): считать позицию "нулевой", если |pos_base|×mid < порога.
# Помогает reduce-only не залипать на микро-остатках и не плодить ордера на копейки. 0 = выключить.
# AUTO_TRADE_POSITION_DUST_QUOTE=0.10
# Авто-выход (paper): take-profit / stop-loss в bps от цены входа; max-hold — время удержания (сек). 0 = выключить.
# AUTO_TRADE_TP_BPS=45
# AUTO_TRADE_SL_BPS=32
# ATR-SL (paper): эффективный SL = max(AUTO_TRADE_SL_BPS, AUTO_TRADE_SL_ATR_MULT × ATR_bps). 0 = выключить ATR-надбавку.
# AUTO_TRADE_SL_ATR_MULT=0
# AUTO_TRADE_MAX_HOLD_SECONDS=300
# MAX_HOLD + MIN_PNL: если net (после оценки fee на закрытие) в диапазоне [0 .. порог) — таймер не закрывает
# (ждём TP/SL/HARD). Если net < 0 — по таймеру закрываем (не держим до SL из‑за порога).
# Базовый порог, если не заданы отдельно LONG/SHORT ниже.
AUTO_TRADE_MAX_HOLD_MIN_PNL_BPS=0
# Разные пороги для long и short (пусто = как AUTO_TRADE_MAX_HOLD_MIN_PNL_BPS).
# AUTO_TRADE_MAX_HOLD_MIN_PNL_BPS_LONG=0
# AUTO_TRADE_MAX_HOLD_MIN_PNL_BPS_SHORT=0
# Жёсткий MAX_HOLD (paper): закрыть позицию при достижении времени, независимо от pnl/min_pnl. 0 = выключить.
# Полезно, чтобы min_pnl не превращался в "держим до SL" во флэте/против тренда.
# AUTO_TRADE_MAX_HOLD_HARD_SECONDS=600
# AUTO_TUNE (paper/ws): авто‑подстройка «тихого рынка» под комиссии/TP.
# Идея: если диапазон mid за окно слишком мал, TP (net) статистически не добирается (после fee) → меньше входов,
# меньше MAX_HOLD/SL во флэте.
#
# Если AUTO_TRADE_AUTO_TUNE=true, бот сам рассчитает порог range(mid) (bps) даже когда SCALPING_MIN_MID_RANGE_BPS=0.
# База: RT_FEE_FRAC×(2×fee) + TP_NET_FRAC×TP_net — короткое окно mid не требует «вместить» весь TP+fee (иначе на BTC
# при TP=8 и fee=6 получалось thr≈15 bps и вечный quiet_market_flat_auto). Затем ×MULT + EXTRA, опционально потолок RANGE_MAX.
# AUTO_TRADE_AUTO_TUNE=true
# AUTO_TRADE_AUTO_TUNE_MIN_MID_RANGE_BPS=0
# AUTO_TRADE_AUTO_TUNE_MID_RANGE_MULT=1.0
# AUTO_TRADE_AUTO_TUNE_MID_RANGE_EXTRA_BPS=1
# AUTO_TRADE_AUTO_TUNE_RT_FEE_FRAC=0.42
# AUTO_TRADE_AUTO_TUNE_TP_NET_FRAC=0.30
# AUTO_TRADE_AUTO_TUNE_RANGE_MAX_BPS=0
# Если true — TP может выставляться даже когда по symbol есть pending-лимитки (обычно лучше false, чтобы избежать "дерготни").
# AUTO_TRADE_TP_ALLOW_WITH_PENDING=false
# Авто-арбитраж: две ноги на разных биржах (нужны ключи и балансы на обеих)
AUTO_TRADE_ARBITRAGE=false
# Минимальный край после комиссий (bps) для авто-арбитража
AUTO_TRADE_MIN_EDGE_BPS=5
# Мин. |импульс| (bps), 0=выкл. momentum: |Δmid| за тик; ta_*: расстояние до BB/SMA в bps (не «2× комиссия»).
# Для трендового рынка на majors полезно поднять до ~16, чтобы отсечь слабые касания BB/SMA.
# SCALPING_AUTO_TRADE_MIN_IMPULSE_BPS=12
# Quiet-market guard (скальпинг+AUTO_TRADE): не входить, если рынок «тихий».
# range(mid) = (max−min)/текущий mid за скользящее окно (формула как в WS-пульсе), после ≥~90% заполнения окна по времени.
# У пульса интервал с фиксированным сбросом каждые N с — числа могут чуть отличаться от guard.
# Если majors часто отсекаются — попробуйте 2 (мягче) или 0 = выключить guard.
# SCALPING_MIN_MID_RANGE_BPS=1
# SCALPING_MIN_MID_RANGE_WINDOW_SECONDS=30

# Только paper (для дебага потока): выставлять лимитки "через спред" (buy по ask, sell по bid),
# чтобы ордера чаще исполнялись и было видно полный цикл fill → exit → realized PnL.
# AUTO_TRADE_PAPER_CROSS_SPREAD=true

# Масштаб AUTO_TRADE_NOTIONAL при высокой микроволатильности (σ тиков, bps; линейно ref→cap)
# SCALPING_AUTO_TRADE_VOL_SCALE=false
# SCALPING_AUTO_TRADE_VOL_REF_BPS=12
# SCALPING_AUTO_TRADE_VOL_CAP_BPS=45
# SCALPING_AUTO_TRADE_VOL_MIN_MULT=0.25
# Калибровка σ тиков для rest/ws (умножение перед vol-scale и детекцией всплеска; на rest часто <1)
# SCALPING_SIGMA_CALIB_REST=1
# SCALPING_SIGMA_CALIB_WS=1
# Пауза AUTO_TRADE после всплеска σ_eff (сек); 0=выкл. Нужен SPIKE_ABS и/или SPIKE_RATIO>0
# SCALPING_SIGMA_SPIKE_ABS_BPS=0
# SCALPING_SIGMA_SPIKE_RATIO=0
# SCALPING_SIGMA_SPIKE_COOLDOWN_SECONDS=0
# Связь с TA-ATR (нужен ta_*): спред не шире ATR×mult; 0=выкл.
# Quality-first ориентиры: 0.25–0.5
# AUTO_TRADE_ATR_MAX_SPREAD_MULT=0.35
# Номинал × min(1, ref/ATR); 0=выкл.; floor — нижняя граница множителя
# Quality-first ориентиры: ref 25–40 bps, floor 0.4–0.7
# AUTO_TRADE_ATR_NOTIONAL_REF_BPS=30
# AUTO_TRADE_ATR_NOTIONAL_FLOOR_MULT=0.5

# Ключи (достаточно одного варианта имён):
# EXCHANGE_API_KEY=...  или  API_KEY=...  или  BYBIT_API_KEY=...
# EXCHANGE_API_SECRET=...  или  API_SECRET=...  /  SECRET_KEY=...  /  BYBIT_API_SECRET=...
# EXCHANGE_API_PASSPHRASE=...  или  API_PASSPHRASE=...  (OKX и др.)
# TRADING_EXCHANGE=binance

# Список бирж (CCXT id). Для arbitrage нужно ≥2. Для scalping удобнее одна биржа — см. SCALPING_EXCHANGE.
ARBITRAGE_EXCHANGES=binance,bybit

# Скальпинг: приоритет у SCALPING_EXCHANGES (несколько WS). Для одной биржи задайте только SCALPING_EXCHANGE — без запятой.
SCALPING_EXCHANGE=bybit
# SCALPING_EXCHANGES=bybit,okx
# Вариант: momentum | mean_reversion | filtered_momentum | rotate | adaptive | ta_regime | ta_conservative | ta_aggressive | ta_trend | ta_rotate | orderflow
# SCALPING_VARIANT=momentum
# --- momentum ---
# Минимальное движение mid за тик (bps) для сигнала импульса
# SCALPING_MOVE_BPS=8
# --- mean_reversion ---
# Вес новой цены в EMA(mid); 0.15 ≈ сглаживание за несколько опросов
# SCALPING_EMA_ALPHA=0.15
# Порог отклонения mid от EMA (bps) для сигнала «фейда»
# SCALPING_REVERSION_DEVIATION_BPS=15
# После сигнала снова «вооружиться», когда |dev| ниже этого (bps); пусто = половина от DEVIATION
# SCALPING_REVERSION_REENTRY_BPS=8
# --- filtered_momentum (σ по последним изменениям mid в bps; 0 = без границы) ---
# SCALPING_VOL_WINDOW=15
# SCALPING_MIN_MICRO_VOL_BPS=2
# SCALPING_MAX_MICRO_VOL_BPS=80
# --- rotate (автосмена под-стратегий по таймеру; не рекурсивный) ---
# SCALPING_VARIANT=rotate
# SCALPING_ROTATE_VARIANTS=momentum,filtered_momentum,mean_reversion
# SCALPING_ROTATE_INTERVAL_SECONDS=3600
# --- ta_rotate (по кругу только TA-подрежимы; интервал тот же, список отдельный) ---
# SCALPING_VARIANT=ta_rotate
# SCALPING_TA_ROTATE_VARIANTS=ta_conservative,ta_trend
# С лентой сделок и давлением стакана (отдельный шаг ротации — не смешивается с TA по времени):
# SCALPING_TA_ROTATE_VARIANTS=ta_conservative,ta_aggressive,ta_trend,orderflow
# SCALPING_ROTATE_INTERVAL_SECONDS=3600
# --- orderflow (только этот вариант или шаг rotate/ta_rotate): верх стакана + краткое окно ленты (WS) ---
# SCALPING_VARIANT=orderflow
# ORDERFLOW_TAPE_WINDOW_SECONDS=2.5
# ORDERFLOW_TAPE_MAX_EVENTS=800
# ORDERFLOW_TAPE_MIN_TOTAL_QUOTE=400
# ORDERFLOW_TAPE_LONG_SHARE=0.58
# ORDERFLOW_TAPE_SHORT_SHARE=0.42
# ORDERFLOW_BOOK_LEVELS=8
# ORDERFLOW_BOOK_RATIO_LONG=1.14
# ORDERFLOW_BOOK_RATIO_SHORT=
# ORDERFLOW_BOOK_MIN_SIDE_QUOTE=80
# both — лента и книга одновременно; either — достаточно одного (больше сигналов, REST без ленты — по книге)
# ORDERFLOW_SIGNAL_MODE=both
# ORDERFLOW_COOLDOWN_SECONDS=2.5
# WS: подписка watch_trades (по умолчанию вкл., если orderflow в SCALPING_*_ROTATE или VARIANT=orderflow)
# ORDERFLOW_WS_COLLECT=true
# --- adaptive (выбор momentum / filtered_momentum / mean_reversion по σ тиков и глубине стакана) ---
# SCALPING_VARIANT=adaptive
# SCALPING_VOL_WINDOW=15
# SCALPING_ADAPTIVE_DEPTH_LEVELS=5
# «Тонкий» стакан / «толстый» (min bid/ask notional по верхним уровням, USDT для USDT-пар)
# SCALPING_ADAPTIVE_DEPTH_THIN=300
# SCALPING_ADAPTIVE_DEPTH_THICK=3000
# Пороги σ (pstdev изменений mid за окно, bps)
# SCALPING_ADAPTIVE_VOL_LOW_BPS=4
# SCALPING_ADAPTIVE_VOL_HIGH_BPS=22
# --- TA на OHLCV (REST; сигнал всё равно на тике стакана ws/rest) ---
# SCALPING_VARIANT=ta_regime
# Для трендового рынка (majors часто “перекуплены” и conservative молчит) удобнее ta_trend:
# SCALPING_VARIANT=ta_trend
# ta_regime: ADX≥TA_REGIME_ADX_TREND → SMA+ADX+ATR; узкие полосы BB → SMA+RSI+BB; иначе SMA+VWAP+VP
# Отдельно: ta_conservative | ta_aggressive | ta_trend
# TA_TIMEFRAME=5m
# TA_OHLCV_LIMIT=120
# TA_OHLCV_REFRESH_SECONDS=45
# TA_SMA_PERIOD=20
# TA_RSI_PERIOD=14
# TA_RSI_OVERSOLD=48
# TA_RSI_OVERBOUGHT=70
# TA_BB_PERIOD=20
# TA_BB_STD=2.0
# TA_ADX_PERIOD=14
# TA_ATR_PERIOD=14
# TA_TREND_ADX_TRIGGER=27
# TA_VWAP_BARS=48
# TA_VP_BINS=24
# TA_AGGRESSIVE_EPS_BPS=3
# Торговля у полос BB: |mid−lower|/mid и |upper−mid| в bps ≤ порога + RSI
# TA_BAND_NEAR_BPS=18
# Quality-first: меньше входов, но выше “подтверждение” (POC)
# TA_AGGR_REQUIRE_POC=true
# TA_REGIME_ADX_TREND=22
# (в коде TA_REGIME_ADX_TREND поднимается до TA_TREND_ADX_TRIGGER, чтобы не было «пустого» режима тренда)
# TA_REGIME_MODE=hierarchy
# hierarchy — тренд/консерв./агресс. по ADX и ширине BB; best_signal — одна заявка: макс. impulse_bps среди трёх, если стороны не конфликтуют
# TA_REGIME_BB_SQUEEZE_BPS=80
# Один сигнал на сторону на свечу (меньше повторов при ws); false — как раньше на каждом тике
# TA_SIGNAL_ONE_PER_BAR=true
# ta_trend: мин. |+DI − −DI|, 0 = выкл.; 2–5 — меньше шума во флэте
# TA_TREND_MIN_DI_DIFF=2
# ta_trend: не LONG, если RSI выше порога (0 = выкл.) — меньше входов «на перегреве»
# TA_TREND_MAX_RSI_LONG=72
# ta_trend: не LONG, если mid дальше чем N bps ВЫШЕ SMA (0 = выкл.) — меньше догона вверх
# TA_TREND_MAX_EXTEND_BPS_LONG=40
# ta_trend: не SHORT, если RSI ниже порога (0 = выкл.)
# TA_TREND_MIN_RSI_SHORT=32
# ta_trend: не SHORT, если mid дальше чем N bps НИЖЕ SMA (0 = выкл.)
# TA_TREND_MAX_EXTEND_BPS_SHORT=40
# Не сигналить, если спред bid/ask шире (bps), пусто = без фильтра
# SCALPING_MAX_SPREAD_BPS=15
# При AUTO_TRADE: симуляция съедания книги — макс. проскальзывание (bps)
# Quality-first: tighter slippage (в бумаге — фильтр по «съеданию книги»)
# SCALPING_MAX_SLIPPAGE_BPS=25
# Перед новой заявкой отменять предыдущие по этой паре
# SCALPING_CANCEL_PREVIOUS_ORDERS=true
# Авто-менеджмент заявок: TTL лимитки с момента создания (сек). 0 = не отменять по времени.
# Ориентиры: ~60–120 — терпеливее к исполнению; ~10–25 — быстрее снимать «старые» котировки.
# SCALPING_ORDER_TTL_SECONDS=240
# Перестановка лимитки ближе к рынку, если текущая цена ушла (bps). 0 = выключить.
# SCALPING_REPRICE_BPS=10
# Минимальная пауза между перестановками (сек)
# SCALPING_REPRICE_COOLDOWN_SECONDS=10
# REST + scalping: раз в N секунд — строка в лог с mid/spread (без сигналов тоже видно, что бот жив); 0 = выключить
# SCALPING_REST_HEARTBEAT_SECONDS=30
# WS + scalping: пульс (тиков стакана, mid/spread, при filtered_momentum — Δ/σ)
# SCALPING_WS_HEARTBEAT_SECONDS=30
# Дедуп INFO по сигналу скальпинга: сброс отпечатка после N сек без сигнала (мерцание WS). 0 — сброс при первом тике без сигнала.
# SCALPING_SIGNAL_LOG_FP_STALE_SECONDS=30

# Пары через запятую
ARBITRAGE_SYMBOLS=BTC/USDT,ETH/USDT

# Комиссия одной ноги (bps). Совпадайте с кабинетом (spot taker ~10; maker/лимитки часто 5–8). Влияет на арбитраж и справочно на live.
ARBITRAGE_FEE_BPS_PER_SIDE=10
# Только paper: комиссия стороны при учёте лимиток (обычно maker, ниже taker). Пусто = как ARBITRAGE_FEE_BPS_PER_SIDE.
# Реалистичнее для лимитного скальпа; не «гарантирует» прибыль, но не занижает PnL из‑за taker-ставки.
# PAPER_FEE_BPS_PER_SIDE=6

# Интервал опроса книг заявок (секунды)
ARBITRAGE_POLL_SECONDS=5

# Только логировать возможности, без ордеров (paper). Боевой режим: false + ключи в secrets.env
ARBITRAGE_PAPER=true

# ---------- Чеклист перед боевым запуском (live) ----------
# • Прогон с ARBITRAGE_PAPER=true: устроила ли частота сигналов и paper PnL (модель, не гарантия прибыли)
# • secrets.env: BYBIT_API_KEY / BYBIT_API_SECRET (или EXCHANGE_API_*); ключ только с правами spot/trade
# • ARBITRAGE_FEE_BPS_PER_SIDE — как у биржи (maker/taker), иначе учёт и фильтры искажены
# • RISK_MAX_* / AUTO_TRADE_NOTIONAL; скальп на нескольких биржах+парах — без RISK_STRICT_RISK_LIMITS лимиты поднимаются в config
# • SCALPING_AUTO_TRADE_MIN_IMPULSE_BPS: для momentum — тиковый шаг; для ta_* — сила сигнала до BB/SMA (см. коммент к переменной)
# • AUTO_TRADE_COOLDOWN_SCOPE=symbol при скальпинге на нескольких биржах — без дублей одной пары
# • При старте с paper=false в лог пишется предупреждение «БОЕВОЙ РЕЖИМ»

# ---------- MCP (Cursor / VS Code) ----------
# По умолчанию в .cursor/mcp.json и .vscode/mcp.json указан postgresql://localhost:5432/postgres — замените при необходимости.
# Секреты не коммитьте: правьте локально или используйте .cursor/mcp.local.json (в .gitignore).
