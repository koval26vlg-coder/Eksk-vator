# Режим: arbitrage (межбиржа) | scalping (импульс на одной бирже)
BOT_STRATEGY=arbitrage

# Список бирж через запятую (id из CCXT): binance, bybit, okx, kucoin, ...
ARBITRAGE_EXCHANGES=binance,bybit,okx

# Скальпинг: одна биржа (если пусто — берётся первая из ARBITRAGE_EXCHANGES)
# SCALPING_EXCHANGE=binance
# Вариант: momentum (импульс за тик) | mean_reversion (отскок к EMA)
# SCALPING_VARIANT=momentum
# --- momentum ---
# Минимальное движение mid за тик (bps) для сигнала импульса
# SCALPING_MOVE_BPS=8
# --- mean_reversion ---
# Вес новой цены в EMA(mid); 0.15 ≈ сглаживание за несколько опросов
# SCALPING_EMA_ALPHA=0.15
# Порог отклонения mid от EMA (bps) для сигнала «фейда»
# SCALPING_REVERSION_DEVIATION_BPS=15
# После сигнала снова «вооружиться», когда |dev| ниже этого (bps); пусто = половина от DEVIATION
# SCALPING_REVERSION_REENTRY_BPS=8
# Не сигналить, если спред bid/ask шире (bps), пусто = без фильтра
# SCALPING_MAX_SPREAD_BPS=15

# Пары через запятую
ARBITRAGE_SYMBOLS=BTC/USDT,ETH/USDT

# Комиссия одной сделки в базисных пунктах (1 bps = 0.01%). Учитывается два раза: вход + выход.
ARBITRAGE_FEE_BPS_PER_SIDE=10

# Интервал опроса книг заявок (секунды)
ARBITRAGE_POLL_SECONDS=5

# Только логировать возможности, без ордеров
ARBITRAGE_PAPER=true
