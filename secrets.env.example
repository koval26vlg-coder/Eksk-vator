# Секреты (API ключи) — НЕ коммитить.
# Файл `secrets.env` добавлен в `.gitignore` — его нужно создать локально.

# Bybit (часто используется именно так)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OKX: passphrase обязателен для торговли — в CCXT передаётся как password
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=

# Общие имена (один набор на все биржи в коде — для live на 2+ биржах обычно нужна доработка под ключи каждой)
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
# EXCHANGE_API_PASSPHRASE=
# TRADING_EXCHANGE=bybit

